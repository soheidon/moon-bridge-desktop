{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moon Bridge Desktop",
  "version": "0.1.0",
  "identifier": "com.soheidon.moon-bridge-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Moon Bridge Desktop", "width": 1100, "height": 720, "minWidth": 760, "minHeight": 520, "resizable": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/moonbridge"]
  }
}
